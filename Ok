def load_product():

    global PRODUCT_ID
    global TICK_SIZE
    global CONTRACT_VALUE
    global MIN_ORDER_SIZE

    data = public_get(
        f"/v2/products/{SYMBOL}"
    )

    product = data.get(
        "result",
        data
    )

    if not isinstance(
        product,
        dict
    ):
        raise RuntimeError(
            "Invalid product response"
        )

    PRODUCT_ID = int(
        product["id"]
    )

    TICK_SIZE = Decimal(
        str(
            product.get(
                "tick_size",
                "0.5"
            )
        )
    )

    CONTRACT_VALUE = Decimal(
        str(
            product.get(
                "contract_value",
                "0.001"
            )
        )
    )

    try:

        MIN_ORDER_SIZE = int(
            Decimal(
                str(
                    product.get(
                        "contract_unit_min_size",
                        1
                    )
                )
            )
        )

    except Exception:

        MIN_ORDER_SIZE = 1

    if MIN_ORDER_SIZE < 1:
        MIN_ORDER_SIZE = 1

    log(
        "PRODUCT LOADED",
        "| SYMBOL:", SYMBOL,
        "| PRODUCT ID:", PRODUCT_ID,
        "| TICK:", TICK_SIZE,
        "| CONTRACT:", CONTRACT_VALUE,
        "| MIN QTY:", MIN_ORDER_SIZE
    )


# ============================================================
# PRICE
# ============================================================

def round_price(price):

    value = Decimal(
        str(price)
    )

    return (
        value / TICK_SIZE
    ).to_integral_value(
        rounding=ROUND_DOWN
    ) * TICK_SIZE


def price_str(price):

    return format(
        round_price(price),
        "f"
    )


